  "$ref": "#/definitions/Manifest",
  "definitions": {
    "Defaults": {
      "type": "object",
      "properties": {
        "install_mode": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "",
            "global",
            "project"
          ],
          "description": "Omission or an empty string uses the applicable default scope."
        }
      },
      "additionalProperties": false
    },
    "Extension": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "",
            "global",
            "project"
          ],
          "description": "Omission or an empty string uses the applicable default scope."
        },
        "source": {
          "$ref": "#/definitions/ExtensionSource"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "codex",
              "claude-code",
              "opencode",
              "pi",
              "antigravity-cli"
            ]
          },
          "description": "Omission or an empty array inherits the manifest target set."
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "carrier",
        "source"
      ]
