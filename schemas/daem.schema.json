            "claude-code": {
              "$ref": "#/definitions/SkillTarget"
            },
            "codex": {
              "$ref": "#/definitions/SkillTarget"
            },
            "opencode": {
              "$ref": "#/definitions/SkillTarget"
            },
            "pi": {
              "$ref": "#/definitions/SkillTarget"
            }
          },
          "additionalProperties": false
