views {
  dynamic view activeRollback {
    title 'Active Apply journal rollback'
    description '''
      An ordinary active Apply journal whose guarded changes can be rolled back. When host and state have committed,
      Recover can instead finalize the prepared claims without replaying host writes. Native Apply has its own document
      recovery path under active journal authority. Current desired content does not substitute for a recorded backup.
      A separate continuing file-set fence can remain; invalid file-set evidence or unprovable StateDir blocks active recovery.
      Permission protection outside the selected effects remains pending for a separate invocation.
    '''
    link ../internal/workflow/recover/recover.go 'Active classification and execution'
    link ../internal/workflow/recover/authority.go 'Active identities and domain projection'
    link ../internal/workflow/recover/journal_protection.go 'Compare the selected effects with pending protection'
    link ../internal/effect/execute/recovery.go 'Ordinary effect and claim settlement'
    link ../internal/effect/execute/nativeoperation/recovery.go 'Native Apply recovery variant'
    link ../internal/workflow/recover/execute_test.go 'Qualified rollback, stale rejection and retirement'

    daem.cli.run -> daem.commands.recover 'Prepare selected active recovery'
    daem.commands.recover -> daem.barrier 'Require the shared metadata fence to be clear for selection'
    daem.commands.recover -> daem.io.journal 'Qualify active record, backups and current recoverable state'
    daem.commands.recover -> daem.barrier 'Check StateDir and the independent file-set fence'
    daem.commands.recover -> daem.safety 'Compile the active recovery identity and required domains'
    daem.commands.recover -> files.registries 'Check selected physical writes and management changes against pending protection'
    daem.commands.recover -> daem.cli.run 'Disclose the rollback action'
    operator -> daem.cli.run 'Confirm the current recoverable operation'
    daem.cli.run -> daem.commands.recover 'Execute the prepared active recovery'
    daem.commands.recover -> daem.io.leases 'Acquire the complete active lease set and revalidate the candidate'
    daem.commands.recover -> files.registries 'Recheck disjointness under the recovery leases'
    daem.commands.recover -> daem.owners.effect 'Execute qualified rollback'
    daem.owners.effect -> files.state 'Bind and verify the recorded baseline against current State'
    daem.owners.effect -> daem.io.storage 'Verify before-images and restore only what the operation owns'
    daem.owners.effect -> files.registries 'Roll back applicable claim transitions'
    daem.owners.effect -> daem.io.journal 'Requalify the resulting state and removal intents before retirement'
    daem.commands.recover -> daem.io.journal 'Classify remaining journal authority alongside the separate file-set outcome'
  }

  dynamic view retiredCleanup {
    title 'Retained journal cleanup only'
    description '''
      An already-retired journal has qualified correlated residue. After the shared metadata check, cleanup has its own
      identity, demand and RecoveryDir authority. It needs no host output observation, installed state, lock or StateDir
      census. Failed garbage collection after semantic retirement does not recreate a recovery action.
    '''
    link ../internal/workflow/recover/selection.go 'Cleanup-only precedence'
    link ../internal/workflow/recover/recover.go 'Cleanup reservation and execution'
    link ../internal/effect/journal/retirement 'Retirement controls and residue'

    daem.cli.run -> daem.commands.recover 'Select recoverable work'
    daem.commands.recover -> daem.barrier 'Check the shared metadata fence for recovery selection'
    daem.commands.recover -> daem.io.journal 'Qualify exact retired-journal control and residue'
    daem.commands.recover -> daem.safety 'Compile cleanup-only identity and domains'
    daem.commands.recover -> daem.cli.run 'Disclose cleanup-only action'
    operator -> daem.cli.run 'Authorize the selected cleanup'
    daem.cli.run -> daem.commands.recover 'Execute the prepared cleanup'
    daem.commands.recover -> daem.io.leases 'Bind and revalidate RecoveryDir-only authority'
    daem.commands.recover -> daem.io.journal 'Settle exact retirement evidence and collect qualified residue'
  }

  dynamic view permissionRecovery {
    title 'Recovery of access after an interrupted invocation'
    description '''
      No active or retained-cleanup journal is selected; the file-set boundary is clear. The selected owner has an
      outstanding protection record. A previous invocation may have recovered an unrelated journal and left the
      protection pending. A bound child must be quiescent. Safe peers can settle without clearing a blocked peer.
      This route does not parse or restore document content, or re-run the child.
    '''
    link ../internal/workflow/recover/selection.go 'Fallback selection and overlap refusal'
    link ../internal/workflow/protection/recovery/execute.go 'Selected recovery and validation'

    daem.cli.run -> daem.commands.recover 'Select recoverable work'
    daem.commands.recover -> daem.barrier 'Check journal and file-set evidence'
    daem.commands.recover -> daem.services.permissionRecovery 'Prepare the selected owner’s retained protection'
    daem.services.permissionRecovery -> files.registries 'Read exact armed or bound record'
    daem.commands.recover -> daem.cli.run 'Disclose protection actions and blockers'
    operator -> daem.cli.run 'Authorize the selected protection recovery'
    daem.cli.run -> daem.commands.recover 'Execute qualified protection recovery'
    daem.commands.recover -> daem.services.permissionRecovery 'Select eligible document authorities'
    daem.services.permissionRecovery -> daem.io.leases 'Acquire the selected document and management authority'
    daem.services.permissionRecovery -> daem.barrier 'Recheck barriers and the selected owner'
    daem.services.permissionRecovery -> files.registries 'Verify current armed or bound records and quiescence'
    daem.services.permissionRecovery -> daem.io.storage 'Restrict added access on qualified existing files'
    daem.services.permissionRecovery -> files.registries 'Settle confirmed records and retain unresolved facts'
  }

  dynamic view declarationRecovery {
    title 'Recovery of the manifest and default lockfile'
    description '''
      This explicit route binds the selected manifest and default lockfile before interpreting the record. A partial
      write is restored from verified before-images. If both files match the completed write, only the record is
      cleared. Recovery does not regenerate the lock or execute an authoring request.
    '''
    link ../internal/workflow/recover/declarations.go 'Selection, preview and leases'
    link ../internal/effect/fileset/recover_pair.go 'Revalidate and settle the exact pair'

    daem.cli.run -> daem.commands.recover 'Select only declaration recovery'
    daem.commands.recover -> daem.barrier 'Check the journal and metadata fences and retain StateDir identity'
    daem.commands.recover -> daem.io.fileset 'Match the exact pair and verify the current and saved images'
    daem.commands.recover -> daem.cli.run 'Disclose rollback or cleanup without writing'
    operator -> daem.cli.run 'Authorize the selected declaration recovery'
    daem.cli.run -> daem.commands.recover 'Consume the prepared recovery'
    daem.commands.recover -> daem.io.leases 'Acquire and check the pair and recovery domains'
    daem.commands.recover -> daem.barrier 'Recheck the retained StateDir and peer fences'
    daem.commands.recover -> daem.io.fileset 'Revalidate the same record and images, then settle'
    daem.io.fileset -> daem.io.storage 'Restore recorded before-images only for rollback'
    daem.io.fileset -> files.recovery 'Retire the exact evidence for the settled pair'
  }

  dynamic view nativeReleaseRecovery {
    title 'Recovery of native configuration management release'
    description '''
      This journal is for an interrupted management release, not Apply or an unrelated declaration edit. Its own
      transaction can settle before current State and ownership determine the remaining release. Once the file-set
      is settled, later declaration and lock edits remain intact. The recovery never rewrites host content.
    '''
    link ../internal/workflow/authoring/agent_config_release_execute.go 'Management-release journal creation'
    link ../internal/workflow/recover/native_release.go 'Release-specific recovery identity and domains'
    link ../internal/effect/execute/nativeoperation/release.go 'Intent-matched file-set then ownership settlement'
    link ../internal/cli/unmanage_agent_config_recovery_test.go 'Public recovery path'

    daem.cli.run -> daem.commands.recover 'Select active management-release recovery'
    daem.commands.recover -> daem.io.journal 'Identify the releasing owner’s journal and recorded control locations'
    daem.commands.recover -> daem.safety 'Bind the release-specific recovery identity and domain steps'
    daem.commands.recover -> files.registries 'Check the released management and selected file-set writes against protection'
    daem.commands.recover -> daem.cli.run 'Disclose the selected metadata release recovery'
    operator -> daem.cli.run 'Authorize this recovery'
    daem.cli.run -> daem.commands.recover 'Consume the prepared recovery'
    daem.commands.recover -> daem.io.leases 'Requalify active recovery under the selected authority'
    daem.commands.recover -> files.registries 'Recheck the release scope and file-set writes under leases'
    daem.commands.recover -> daem.barrier 'Validate shared metadata and retained StateDir authority'
    daem.commands.recover -> daem.owners.effect 'Execute selected native management release recovery'
    daem.owners.effect -> files.registries 'Refuse pending protection for the selected release'
    daem.owners.effect -> daem.io.fileset 'Settle only the journal’s manifest, default lock and State transaction'
    daem.owners.effect -> files.state 'Assess the current State after local settlement'
    daem.owners.effect -> files.registries 'Keep or finish releasing the old owner’s exact metadata'
    daem.owners.effect -> daem.io.journal 'Retire settled release evidence'
  }

  dynamic view missingStateRelease {
    title 'Explicit release of output claims when installed state is missing'
    description '''
      This opt-in recovery route does not restore a journal, repair a file, release a carrier claim, or clear permission
      protection. It compares the exact missing-state proof and selected settled rows before publishing a registry change.
    '''
    link ../internal/workflow/recover/output_release.go 'Read, disclose and release the selected output rows'

    daem.cli.run -> daem.commands.recover 'Select explicit output ownership release'
    daem.commands.recover -> daem.barrier 'Validate selected recovery barriers'
    daem.commands.recover -> files.state 'Prove the selected statefile is absent'
    daem.commands.recover -> files.registries 'Qualify only settled output claims and bindings'
    daem.commands.recover -> daem.cli.run 'Disclose the rows eligible for release'
    operator -> daem.cli.run 'Authorize release of those rows'
    daem.cli.run -> daem.commands.recover 'Execute the approved release'
    daem.commands.recover -> daem.io.leases 'Acquire state and output registry authority'
    daem.commands.recover -> daem.barrier 'Revalidate barriers and leased authority'
    daem.commands.recover -> files.state 'Reconfirm the exact missing-state witness'
    daem.commands.recover -> daem.io.storage 'Compare the settled rows again and publish the qualified registry write'
    daem.io.storage -> files.registries 'Remove only the selected output claims and bindings'
  }

  dynamic view metadataRecovery {
    title 'Shared metadata conversion recovery'
    description '''
      Recover a published conversion from its recorded original selection, even when invoked from another workspace
      sharing the data directory. With no active conversion, metadata recovery separately checks for eligible cleanup
      or a no-op. It does not replay installed host outputs.
    '''
    link ../internal/effect/metadataconversion/recover.go 'Original selection and exact file-set recovery'
    link ../internal/workflow/migrate/metadata.go 'Active recovery versus cleanup selection'

    daem.cli.run -> daem.commands.migrate 'Select recovery of a published metadata conversion'
    daem.commands.migrate -> daem.barrier 'Identify the active global metadata fence'
    daem.commands.migrate -> daem.io.conversion 'Qualify the recorded original selection and cohort'
    daem.io.conversion -> daem.io.fileset 'Inspect marker, retained intent and target evidence'
    daem.commands.migrate -> daem.cli.run 'Disclose the selected metadata-only action'
    operator -> daem.cli.run 'Authorize the selected migration recovery'
    daem.cli.run -> daem.commands.migrate 'Execute the selected recovery'
    daem.io.conversion -> daem.io.leases 'Acquire and revalidate the participating authority'
    daem.io.conversion -> daem.io.fileset 'Recompute intent from retained before-images and match the prepared disposition'
    daem.io.conversion -> daem.barrier 'Recheck the global metadata recovery authority before settlement'
    daem.io.conversion -> daem.io.fileset 'Restore or finalize the exact recorded transaction'
    daem.io.fileset -> daem.io.storage 'Confirm terminal State and registry images, restoring recorded before-images on rollback'
    daem.io.fileset -> files.recovery 'Retire the exact active publication evidence'
  }

  dynamic view stateRelocation {
    title 'Relocation of the legacy default-user state'
    description '''
      State migration transfers an installed baseline and shared claim authority, not installed host contents. The
      interrupted variant inspects and settles the same target set instead of writing new state. It does not use the
      shared metadata conversion’s cohort or recorded original selection.
    '''
    link ../internal/workflow/migrate/state.go 'Legacy and current authority selection'
    link ../internal/workflow/migrate/execute.go 'Relocation publication or recovery'

    daem.cli.run -> daem.commands.migrate 'Select legacy default-user state relocation'
    daem.commands.migrate -> daem.barrier 'Qualify the source and target barriers'
    daem.commands.migrate -> files.state 'Read the legacy baseline and prove the destination is unoccupied'
    daem.commands.migrate -> files.registries 'Qualify the shared claim transfer'
    daem.commands.migrate -> daem.cli.run 'Disclose the selected transfer'
    operator -> daem.cli.run 'Authorize the migration'
    daem.cli.run -> daem.commands.migrate 'Execute the selected transfer'
    daem.commands.migrate -> daem.safety 'Compile relocation authority for the four targets'
    daem.commands.migrate -> daem.io.leases 'Acquire both sides and revalidate the revisions'
    daem.commands.migrate -> daem.io.fileset 'Publish the new state and both registries, with the old-state receipt as commit point'
  }
}
