model {
  extend daem.owners.assurance {
    installedState = domainObject 'Installed State snapshot' 'Published projection baselines, carrier facts, and attempt rows.' {
      description '''
        `durable.Snapshot` has at most one managed baseline per projection subject, either a path row or a managed
        aggregate row. It rejects duplicate path destinations and a managed path at an aggregate root. Several
        subjects at one physical projection must carry the same shared-set contract. State also holds pending
        carrier work, project carrier claims, and the latest attempt per key. None of these rows is a fresh host observation.
        A native document commit counter can distinguish phases even when the managed membership itself is unchanged.
      '''
      link ../../internal/assurance/durable/snapshot.go 'Snapshot fact families and invariants'
      link ../../internal/assurance/statefile/image_codec.go 'Persistence format selection'
      link ../../internal/effect/journal/record/native_commit_test.go 'State-neutral changes and commit evidence'
    }
    pathBaseline = domainObject 'Managed path baseline' 'Projection subject, destination, scope, consumer targets, and installed facts.' {
      description '''
        `ManagedPathState` holds one last-applied hash and the applicable content and permission policy. A copied
        directory with an installed-content hash can retain the shipped membership of the verified release, never
        the set of paths that happened to be present on the host. Unknown membership is different from a known empty
        list. Multiple consumer targets in one row describe the same output. A baseline can outlive its declaration.
      '''
      link ../../internal/assurance/durable/managed_path.go 'Path baseline and installed membership admission'
      link ../../internal/supply/artifact/tree_members.go 'Known and unknown tree membership'
    }
    aggregateBaseline = domainObject 'Managed contribution baseline' 'One projection subject and its last managed contribution.' {
      description '''
        `ManagedAggregateState` retains the canonical contribution and full contract for one subject. A settings
        document can have several such rows. The baseline identifies previously managed content, not a digest of
        every byte of the settings file or proof that the document still binds to the same physical target.
      '''
      link ../../internal/assurance/durable/managed_aggregate.go 'Validated subject and contribution'
    }
    pathEvidence = domainObject 'Live path evidence' 'Presence, mode and applicable digest or membership evidence.' {
      description '''
        `ManagedPathEvidence` records current file facts for comparison. Whole-tree hashes and a verified
        shipped-members projection answer different questions. For a copied skill, user-added files can be outside
        the no-op comparison; changed or missing shipped files cannot. For a legacy source-digest row, fresh Supply
        can provide the member paths only when the lock still pins the recorded digest. Membership-only observation
        for an installed digest requires the same placement and installed release digest. Replacement and removal
        need the whole affected tree. Matching bytes in a user-added file do not make it a previously shipped member.
      '''
      link ../../internal/assurance/observe/managed_path.go 'Current path and verified tree evidence'
      link ../../internal/workflow/readiness/managed_path.go 'Choose observation scope from lock and State'
      link ../../test/cli/lifecycle/managedpath/skill_membership_test.go 'Current extras, shipped drift, and release changes'
    }
  }

  extend daem.owners.reconcile {
    decisions = domainObject 'Reconciliation result' 'Typed decisions qualified for inspect, dry-run, or apply.' {
      description '''
        `reconcile.Result` keeps path, aggregate, native narrowing, relation, order, carrier adoption/absence,
        handoff, and delegate decisions distinct. The builder compares locked intent with durable State, current
        observations and relevant ownership facts. Native narrowing consumes a whole-file baseline and produces
        key contributions without duplicating its effects as ordinary projection decisions. Result rows and their
        rendered messages describe work; neither substitutes for approval, a lease, or a revalidated effect plan.
      '''
      link ../../internal/reconcile/result.go 'Canonical typed decisions and operation context'
      link ../../internal/reconcile/native_narrowing_result.go 'Separate native narrowing and no double ownership'
      link ../../internal/workflow/readiness 'Observation and reconciliation assembly'
    }
    pathDecision = domainObject 'Managed path decision' 'One physical occupancy decision: write, record, no-op, or block.' {
      description '''
        `ManagedPathDecision` distinguishes create/replace/remove from State-only record/retire-absent, no-op, and
        refusal. An exact but unmanaged existing path can be recorded only with `apply --manage-existing`
        (`managed_existing`). At an already recorded location, matching live content can update a stale baseline,
        permission policy or exact mode, or consumer set (`state_stale`). Neither kind of record writes host content.
        Moving a managed output uses separate evidence for the previous and replacement locations.
      '''
      link ../../internal/reconcile/managed_path_decision.go 'Closed decision kinds and authority implications'
      link ../../internal/reconcile/build/projection/managed_path_reconcile.go 'Baseline, drift, and movement'
    }
    aggregateDecision = domainObject 'Aggregate decision' 'One document decision, distinct projections, and member deltas.' {
      description '''
        An `AggregateDecision` retains target/scope, document/codec, and one or more projection decisions.
        The projection decisions keep observed/expected evidence and subject-specific membership changes. For
        example, deleting one managed hook member does not authorize deleting its shared settings file or erasing
        unrelated config. Distinct codec decisions can be composed after physical placement is qualified.
      '''
      link ../../internal/reconcile/managed_aggregate.go 'Aggregate decision and subject deltas'
      link ../../internal/realization/aggregate/compose/document.go 'Shared document composition'
    }
    nativeNarrowing = domainObject 'Whole-to-key narrowing' 'One whole baseline and an optional retained-key plan.' {
      description '''
        `NativeNarrowingAction` ties an exact key-mode source to the previous whole-file baseline and the same
        live document. When the whole-file digest still matches, narrowing may write the retained keys to their
        desired values while preserving released values and surrounding comments. With whole-file drift, including a format-only
        edit, every retained key must already match its desired value; otherwise the current values must be captured
        into the source before narrowing. An empty selection keeps the file without a key plan. The action consumes
        the old baseline and new key subjects rather than running separate path and aggregate decisions for them.
      '''
      link ../../internal/reconcile/native_narrowing.go 'Validated action inputs and optional key plan'
      link ../../internal/reconcile/build/documenttransition/narrowing_test.go 'Readback, drift, and release-only narrowing'
      link ../../internal/reconcile/build/documenttransition/narrowing_no_custody_test.go 'Rewrite retained keys without deleting released content'
    }
    nativeWholeAdoption = domainObject 'Key-to-whole adoption' 'An exact whole-file record plus prior key retirements.' {
      description '''
        `NativeWholeAdoptionPlan` records a whole-file baseline without changing host bytes. It needs the actual
        source, matching existing content, `--manage-existing`, and the exact active claims for the
        prior key subjects of the same declaration and document. It cannot consume another participant, omit old
        keys, or retarget the file. A blocked decision does not retire its earlier key subjects.
      '''
      link ../../internal/reconcile/build/projection/native_whole_adoption.go 'Exact source, claims, and retirements'
      link ../../internal/workflow/readiness/native_planning_ownership_test.go 'Actual before evidence without host mutation'
    }
  }

  extend daem.safety {
    operationBasis = domainObject 'Compiled operation basis' 'Selected authority facts and, for migrated work, bounded effect demand.' {
      description '''
        An `operationplan.Fact` records authorizing inputs such as path access, a route, a barrier, or a document
        selection. A `DomainStep` either requests a path domain for the State Barrier to resolve or carries a
        domain an owner already compiled. For migrated Apply paths the effect envelope describes typed work and
        semantic demand; the Barrier lowers it to physical reservations. Fingerprints compare the relevant plan
        inputs across boundaries. They do not establish filesystem identity or hold a lease.
      '''
      link ../../internal/operationplan/fact.go 'Authority fact variants'
      link ../../internal/operationplan/domain_request.go 'Logical and physical domain requests'
      link ../../internal/operationplan/envelope.go 'Operation-specific effect demand'
    }
  }

  extend daem.barrier {
    effectAuthority = domainObject 'Qualified effect authority' 'Selected StateDir identity, mutation domains, and revision evidence.' {
      description '''
        `recoverygate.EffectAuthority` preserves captured StateDir identity and the recovery-root and mutation
        revision requests for a forward command. It supplies evidence to lease and revalidation boundaries.
        `ForwardEffectAuthority` consumes reserved work and can hand off the selected descendant reservation.
        An exact State owner key is durable provenance, distinct from this command's live authority to proceed.
      '''
      link ../../internal/recoverygate/authority.go 'Forward authority and reservation'
      link ../../internal/recoverygate/state_dir_authority.go 'Retained directory incarnation'
    }
    recoveryObservation = domainObject 'Recovery barrier observation' 'Independent journal and file-set axes.' {
      description '''
        `recoverygate.State` preserves whether each axis was observed and classified. Unknown or unobserved is
        not clear. On the file-set axis, invalid evidence or unprovable StateDir access blocks active journal
        recovery. A published marker, markerless residue, or an over-budget census can remain as a separate fence.
        Permission recovery, unlike active journal recovery, requires a known-clear file-set observation.
      '''
      link ../../internal/recoverygate/model.go 'Observed, known and continuing recovery evidence'
      link ../../internal/workflow/recover/selection.go 'Different refusal rules for permission recovery'
    }
  }

  extend daem.owners.effect {
    physicalPlacement = domainObject 'Journal document placement' 'Operation-local alias groups for before and after State.' {
      description '''
        `journal/document.PhysicalPlacement` maps the qualified logical aliases to one group per phase. Group
        numbers are local to the selected work. A logical alias normally keeps the same group in both phases.
        The explicit `CarrierTransfer` exception currently applies to the global Claude Code MCP document and
        permits separate source and destination groups. It moves only MCP key state: the source retires every
        prior MCP projection without deleting the document, and the destination covers every expected MCP projection.
        Removal uses retirement instead. Placement still relies on independent physical evidence, bindings and claim checks.
      '''
      link ../../internal/effect/journal/document/physical_placement.go 'Aliases, before/after groups, and transfer'
      link ../../internal/effect/journal/document/physical_placement_test.go 'One group per phase and admitted transfer'
    }
    journalRecord = domainObject 'Effect journal record' 'One operation’s exact claim, State, and recovery evidence.' {
      description '''
        Ordinary Apply records before/expected-after State and selected entries, claim transitions, provisional
        acquires, and any declared removal intent. Native Apply can also retain qualified physical document groups,
        selected images and member evidence, and exact claim and binding fragments. A NativeRelease record instead
        describes metadata and control-file retirement for `unmanage agent-config`; it does not reapply host content.
        The journal records what an interrupted operation may settle, not which phase is currently true.
      '''
      link ../../internal/effect/journal/record/model.go 'Ordinary journal body'
      link ../../internal/effect/journal/record/native_body.go 'Native document groups and evidence'
      link ../../internal/effect/journal/record/native_release.go 'Metadata-only release record'
    }
    claimTransition = domainObject 'Prepared ownership transition' 'Before, prepared, and expected-after output claims.' {
      description '''
        An ordinary acquisition is absent → reserved → active. Release keeps the active claim during the effect and
        removes it at settlement. Retain checks the same active claim throughout an update or State refresh. A
        provisional acquire is not a claim; the exact post-publication identity is recorded in the journal before
        reserving it. Native reshape compares whole selected claim fragments for one document and owner.
      '''
      link ../../internal/effect/mutation/ownership/transition.go 'Ordinary transition variants'
      link ../../internal/effect/execute/ordinary_claim_promotion.go 'Journal promotion before provisional reservation'
      link ../../internal/output/ownership/convergence_documents.go 'Native claim fragment convergence'
    }
    recoveryBasis = domainObject 'Qualified journal recovery' 'Selected evidence and a classified phase, not execution replay.' {
      description '''
        An active recovery assessment compares current paths, qualified backups, State, and claims with the record.
        Clean-before and clean-after can retire evidence. Recoverable paths, before-State and eligible claims allow
        rollback. Expected-after paths and State with claims eligible to finalize allow claim settlement without
        host replay. A contradiction can block both choices. Selection gives retired-journal cleanup priority over
        permission recovery; cleanup execution needs only its RecoveryDir authority. Active journal and protection
        evidence for the same owner refuse in combination. Permission-only recovery is selected without a blocker
        only where no recoverable journal is found and the file-set axis is known clear.
      '''
      link ../../internal/effect/journal/recovery/classify.go 'Recovery phase from independent evidence'
      link ../../internal/effect/journal/recoveryoperation/plan.go 'Active or cleanup-only authority'
      link ../../internal/workflow/recover/selection.go 'Selection precedence and protection overlap'
      link ../../internal/effect/execute/ownership_apply_test.go 'After-State cancellation finalizes without replay'
    }
    fileSetRecord = domainObject 'File-set publication record' 'Multi-file transaction evidence, distinct from an Apply journal.' {
      description '''
        The file-set marker identifies one publication with selected targets and before/after evidence. Local declaration
        changes and shared metadata conversion use different authority scopes. A published file-set marker can remain
        beside an active Apply journal: recovery of that journal does not imply the marker is settled. Matching
        NativeRelease recovery is the exception that settles its own local file-set before interpreting current State.
        Invalid file-set evidence or unprovable StateDir access blocks active journal recovery.
      '''
      link ../../internal/effect/fileset/transaction.go 'Published, invalid, markerless, and other fence observations'
      link ../../internal/workflow/recover/recover.go 'Independent recovery fences'
      link ../../internal/effect/execute/nativeoperation/release.go 'Settle the release-owned file-set before State'
      link ../../internal/effect/metadataconversion/recover.go 'Separate metadata cohort recovery'
    }
  }

  daem.owners.assurance.stateAuthority .domainRelation daem.owners.assurance.installedState 'Selects the installed baseline statefile'
  daem.owners.assurance.installedState .domainRelation daem.owners.assurance.pathBaseline 'At most one baseline per projection across both families'
  daem.owners.assurance.installedState .domainRelation daem.owners.assurance.aggregateBaseline 'At most one baseline per projection across both families'
  daem.owners.assurance.installedState .domainRelation daem.owners.assurance.attemptHistory 'Retains the latest attempt row per key'
  daem.owners.assurance.installedState .domainRelation daem.owners.assurance.pendingCarrier 'Retains local pending work'
  daem.owners.assurance.installedState .domainRelation daem.owners.assurance.carrierClaim 'Stores project claims; global claims use carrier Registry'
  daem.owners.assurance.pathBaseline .domainRelation daem.owners.realization.pathProjection 'Identifies the projection previously installed'
  daem.owners.assurance.aggregateBaseline .domainRelation daem.owners.realization.aggregateContribution 'Retains the previously managed contribution'
  daem.owners.assurance.pathEvidence .domainRelation daem.owners.assurance.pathBaseline 'Live digest verifies recorded release members, not a new inventory'
  daem.owners.realization.lockSnapshot .domainRelation daem.owners.reconcile.decisions 'Provides the locked desired side of comparison'
  daem.owners.assurance.installedState .domainRelation daem.owners.reconcile.decisions 'Provides prior baselines and carrier facts'
  daem.owners.outputIdentity.registry .domainRelation daem.owners.reconcile.decisions 'Provides relevant ownership and protection facts'
  daem.owners.reconcile.decisions .domainRelation daem.owners.reconcile.pathDecision 'Can include path occupancy decisions'
  daem.owners.reconcile.decisions .domainRelation daem.owners.reconcile.aggregateDecision 'Can include native document decisions'
  daem.owners.reconcile.decisions .domainRelation daem.owners.reconcile.nativeNarrowing 'Carries a distinct ownership transition'
  daem.owners.assurance.pathEvidence .domainRelation daem.owners.reconcile.pathDecision 'Provides independent live path evidence'
  daem.owners.assurance.aggregateEvidence .domainRelation daem.owners.reconcile.aggregateDecision 'Provides selected live document evidence'
  daem.owners.reconcile.nativeNarrowing .domainRelation daem.owners.assurance.pathBaseline 'Consumes the previous whole-file baseline'
  daem.owners.reconcile.nativeNarrowing .domainRelation daem.owners.realization.documentObservation 'Nonempty selection uses the whole digest and key evidence'
  daem.owners.reconcile.nativeNarrowing .domainRelation daem.owners.assurance.aggregateBaseline 'Writes retained keys when needed and records their baselines'
  daem.owners.reconcile.nativeWholeAdoption .domainRelation daem.owners.reconcile.pathDecision 'Produces Record or Blocked, not a host write'
  daem.owners.reconcile.nativeWholeAdoption .domainRelation daem.owners.assurance.aggregateBaseline 'Retires exactly the prior keys on success'
  daem.owners.reconcile.nativeWholeAdoption .domainRelation daem.owners.outputIdentity.claim 'Admits only the selected active claim fragment'
  daem.owners.reconcile.decisions .domainRelation daem.safety.operationBasis 'Selected work supplies plan identity inputs'
  daem.safety.operationBasis .domainRelation daem.barrier.effectAuthority 'Domain requests and demand for boundary qualification'
  daem.barrier.effectAuthority .domainRelation daem.owners.effect.journalRecord 'Forward publication requires revalidated authority'
  daem.owners.effect.physicalPlacement .domainRelation daem.owners.realization.documentAddress 'One physical group per alias and phase'
  daem.owners.effect.physicalPlacement .domainRelation daem.owners.assurance.physicalPath 'Uses independently qualified physical identity'
  daem.owners.realization.documentCandidate .domainRelation daem.owners.effect.physicalPlacement 'Composition requires one qualified group'
  daem.owners.effect.journalRecord .domainRelation daem.owners.effect.physicalPlacement 'Native records retain selected physical groups'
  daem.owners.effect.journalRecord .domainRelation daem.owners.effect.claimTransition 'Preserves claim changes and unpromoted intents'
  daem.owners.effect.journalRecord .domainRelation daem.owners.assurance.installedState 'Captures exact before and after State'
  daem.owners.effect.journalRecord .domainRelation daem.owners.effect.fileSetRecord 'NativeRelease recovery settles its matching local transaction'
  daem.owners.effect.claimTransition .domainRelation daem.owners.outputIdentity.claim 'Compares and settles the recorded phases'
  daem.owners.effect.recoveryBasis .domainRelation daem.owners.effect.journalRecord 'Classifies the selected record against fresh evidence'
  daem.owners.effect.recoveryBasis .domainRelation daem.owners.outputIdentity.registry 'Checks the selected claim phase and applicable fences'
  daem.owners.effect.recoveryBasis .domainRelation daem.owners.assurance.installedState 'Matches recorded State or refuses an unproven phase'
  daem.barrier.recoveryObservation .domainRelation daem.owners.effect.recoveryBasis 'Qualifies journal recovery independently of the file-set fence'
  daem.barrier.recoveryObservation .domainRelation daem.owners.outputIdentity.permissionProtection 'A non-clear file-set fence blocks permission recovery'
}

views 'Domain model' {
  view domainOverview {
    title 'Domain model overview'
    order 1
    description '''
      Desired names the entity; Topology names the things daem may lock or manage. Supply names exact content,
      independently of host placement. Reconciliation compares locked intent with the current host and installed
      State. Claims say who owns an output, while the journal relates one authorized effect to evidence for its
      before and expected-after phases. Open the other Domain model views for each identity and relationship.
    '''
    include daem.owners.desired.environment, daem.owners.topology.graph, daem.owners.topology.subjectId,
      daem.owners.supply.exactArtifact, daem.owners.realization.lockedSubject, daem.owners.realization.lockSnapshot,
      daem.owners.assurance.installedState, daem.owners.outputIdentity.registry, daem.owners.reconcile.decisions,
      daem.owners.effect.journalRecord
    exclude * -> * where kind is not domainRelation
  }

  view domainBaselines {
    title 'Installed baselines and reconciliation decisions'
    order 10
    description '''
      A copied skill can have extra files and still be a no-op against the last shipped membership. Its whole-tree
      replacement, if selected, is a separate effect. A matching unmanaged output still needs `--manage-existing`
      to record ownership. Compare the durable baseline, live observation, and selected decision for each case.
    '''
    link ../../internal/workflow/apply/native_shared_source_command_test.go 'Native decisions on shared and separate documents'
    link ../../test/cli/lifecycle/managedpath/skill_membership_test.go 'Tree membership and replacement'
    include daem.owners.realization.lockSnapshot, daem.owners.assurance.installedState, daem.owners.assurance.pathBaseline,
      daem.owners.assurance.aggregateBaseline, daem.owners.assurance.pathEvidence, daem.owners.assurance.aggregateEvidence,
      daem.owners.reconcile.decisions, daem.owners.reconcile.pathDecision, daem.owners.reconcile.aggregateDecision,
      daem.owners.outputIdentity.registry
    exclude * -> * where kind is not domainRelation
  }

  view domainRecovery {
    title 'Effect authority, journals, and recovery evidence'
    order 11
    description '''
      Host data and State can both be committed while the output claim is still reserved. Before the journal is
      retired, recovery can finalize the claim from that evidence without repeating the host change. The record
      must be matched against the current boundary. A published file-set can remain during active journal recovery
      but blocks permission-only recovery. Retired-journal cleanup is selected ahead of permission recovery.
    '''
    link ../../internal/effect/execute/ownership_apply_test.go 'Committed State with a reserved claim'
    link ../../internal/cli/unmanage_agent_config_recovery_test.go 'Metadata-only release and its file-set'
    include daem.owners.reconcile.decisions, daem.safety.operationBasis, daem.barrier.effectAuthority, daem.barrier.recoveryObservation,
      daem.owners.effect.journalRecord, daem.owners.effect.physicalPlacement, daem.owners.effect.claimTransition,
      daem.owners.assurance.installedState, daem.owners.outputIdentity.claim, daem.owners.outputIdentity.registry,
      daem.owners.effect.recoveryBasis, daem.owners.effect.fileSetRecord, daem.owners.outputIdentity.permissionProtection
    exclude * -> * where kind is not domainRelation
  }

  view domainNativeTransitions {
    title 'Changing the scope of native document ownership'
    order 12
    description '''
      The same declaration can change ownership mode without moving its document. Whole-to-keys can rewrite
      retained keys while preserving released content. Keys-to-whole needs `--manage-existing` and an existing
      exact match; it records the new ownership and retires the earlier keys without rewriting the document.
    '''
    include daem.owners.reconcile.nativeNarrowing, daem.owners.reconcile.nativeWholeAdoption, daem.owners.reconcile.pathDecision,
      daem.owners.realization.documentObservation, daem.owners.assurance.pathBaseline, daem.owners.assurance.aggregateBaseline,
      daem.owners.outputIdentity.claim
    exclude * -> * where kind is not domainRelation
  }
}
